# ─── OFFICE TO THE TOP - LOCAL CONFIG ───
# Copy to .env and fill in your values
# Values with $ MUST be single-quoted: 'value$with$dollars'

# ─── TIMEZONE ───
TZ=Asia/Jakarta

# ─── EVOLUTION API (Local) ───
EVOLUTION_INSTANCE=kantor-ai
EVOLUTION_API_KEY='office-to-the-top-secret-key-change-me'
EVOLUTION_URL=http://localhost:8080

# ─── SUPABASE (Cloud Free Tier - RECOMMENDED) ───
# Create project at supabase.com → Settings → API
# Use NEW keys: sb_publishable_... and sb_secret_... (anon/service_role deprecated late 2026)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ─── LLM KEYS (for agents) ───
# Gemini: https://aistudio.google.com/apikey (FREE)
GEMINI_API_KEY=
# Anthropic: https://console.anthropic.com/ (PAID)
ANTHROPIC_API_KEY=
# Optional: custom base URL if blocked
ANTHROPIC_BASE_URL=
GEMINI_BASE_URL=

# ─── WHATSAPP SETTINGS ───
# Comma-separated JIDs allowed to trigger agents. Empty = all chats.
# Get JIDs from Evolution API logs or scripts/get-chats.js
# Format: 120363012345678901@g.us,628123456789@s.whatsapp.net
WA_ALLOWED_CHATS=

# ─── CLOUDFLARE TUNNEL (Optional - for public webhook) ───
# Run: npm run tunnel → copy https://xxx.trycloudflare.com
# Then set webhook in Evolution API to: https://xxx.trycloudflare.com/webhook/wa-incoming
TUNNEL_URL=

# ─── AGENT CONFIGS (Optional per-agent overrides) ───
AKUNTAN_MODEL=claude-3-5-sonnet-20241022
AKUNTAN_VISION=anthropic
AKUNTAN_ADMIN_CHATS=
AKUNTAN_PENGELUARAN_CHATS=